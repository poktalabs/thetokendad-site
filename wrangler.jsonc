{
  // Static-assets-only Worker. There is no server script and no Astro adapter —
  // `output: 'static'` is unchanged, so this does NOT reopen the static lock.
  // Cloudflare now steers all new projects to Workers rather than Pages; this is
  // that path, and it is also the one that can later grow a server handler
  // without migrating platforms.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thetokendad-site",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist"
  },
  // Custom domains declared here rather than clicked in the dashboard, so the
  // hostname a deploy serves is part of the repo and survives a rebuild from
  // scratch. Cloudflare creates the DNS records and provisions certs.
  "routes": [
    { "pattern": "thetoken.dad", "custom_domain": true },
    { "pattern": "www.thetoken.dad", "custom_domain": true }
  ]
}
