{
  // Frozen version "claude-impeccable" of the canvas. Design run — arm 2, Impeccable
  // Deploy: bunx wrangler deploy --config archive/wrangler.claude-impeccable.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thetokendad-claude-impeccable",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./claude-impeccable"
  },
  // Custom domain declared in-repo, not the dashboard, so a rebuild re-asserts
  // the hostname. Single DNS label — Universal SSL covers one level. Without this
  // the Worker has no route (workers.dev is disabled) and is unreachable.
  "routes": [
    { "pattern": "claude-impeccable.thetoken.dad", "custom_domain": true }
  ]
}
