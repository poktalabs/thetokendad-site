{
  // Frozen version "claude-taste" of the canvas. Design run — arm 3, Taste (design-taste-frontend)
  // Deploy: bunx wrangler deploy --config archive/wrangler.claude-taste.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thetokendad-claude-taste",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./claude-taste"
  },
  // Custom domain declared in-repo, not the dashboard, so a rebuild re-asserts
  // the hostname. Single DNS label — Universal SSL covers one level. Without this
  // the Worker has no route (workers.dev is disabled) and is unreachable.
  "routes": [
    { "pattern": "claude-taste.thetoken.dad", "custom_domain": true }
  ]
}
