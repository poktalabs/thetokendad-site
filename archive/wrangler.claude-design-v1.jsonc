{
  // Frozen version "claude-design-v1" of the canvas. Design run — arm 1, Claude frontend-design skill
  // Deploy: bunx wrangler deploy --config archive/wrangler.claude-design-v1.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thetokendad-claude-design-v1",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./claude-design-v1"
  },
  // Custom domain declared in-repo, not the dashboard, so a rebuild re-asserts
  // the hostname. Single DNS label — Universal SSL covers one level. Without this
  // the Worker has no route (workers.dev is disabled) and is unreachable.
  "routes": [
    { "pattern": "claude-design-v1.thetoken.dad", "custom_domain": true }
  ]
}
