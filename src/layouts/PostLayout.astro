---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;

// The post header is where stamp and word meet. Everywhere else in the site
// the stamp travels alone, and by then the reader has been taught it.
const STAMP: Record<string, string> = {
  genesis: 'origin',
  'building in public': 'origin',
  hosting: 'route',
  cloudflare: 'route',
  vercel: 'route',
  deploy: 'route',
  astro: 'frame',
  stack: 'frame',
  build: 'frame',
  receipts: 'measure',
  cost: 'measure',
  numbers: 'measure',
  correction: 'repair',
  postmortem: 'repair',
};
const stampFor = (tag: string) => STAMP[tag.toLowerCase()] ?? 'mark';
const stampClass = (tag: string) => (stampFor(tag) === 'repair' ? 'stamp stamp--alert' : 'stamp');
---

<BaseLayout title={title} description={description} section="post" stamp={stampFor(tags[0] ?? "")}>
  <Fragment slot="plate">
    <h1 class="plate-title plate-title--post">{title}</h1>
    <div class="plate-meta">
      <FormattedDate date={pubDate} />
      {
        updatedDate && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>updated</span>
            <FormattedDate date={updatedDate} />
          </>
        )
      }
    </div>
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">
              <svg class={stampClass(tag)} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <use href={`#s-${stampFor(tag)}`} />
              </svg>
              <span>{tag}</span>
            </li>
          ))}
        </ul>
      )
    }
  </Fragment>

  <hr class="divider" />

  <article class="prose">
    <slot />
  </article>
</BaseLayout>
