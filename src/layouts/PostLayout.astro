---
/*
  Post layout: a ruled header (date, kind, title, one-line description)
  over the reading surface. Same grammar as the feed row, opened up.
*/
import BaseLayout from './BaseLayout.astro';
import { kindOf } from '../lib/posts';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description}>
  <article class="post wrap-prose">
    <header class="post-head">
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{iso(pubDate)}</time>
        <span class="kind">{kindOf(tags)}</span>
        {updatedDate && <span class="updated">updated {iso(updatedDate)}</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-lede">{description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="post-foot">
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (<li>{tag}</li>))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post { padding-block: 3.5rem 5rem; }

  .post-head {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }
  .kind {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post-head h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 3rem);
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  .post-lede {
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .post-foot {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
  }
</style>
