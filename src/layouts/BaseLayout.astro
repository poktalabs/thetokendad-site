---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SOCIAL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// `compressHTML: 'jsx'` removes the whitespace between adjacent inline elements
// at build time, which is why every gap in this file comes from flex + gap and
// why any string with a space inside it is built as one expression rather than
// as several nodes with literal spaces between them.
const copyright = `© ${new Date().getFullYear()} ${SITE_TITLE}`;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="border-b border-rule">
      <div
        class="mx-auto flex h-18 max-w-shell items-center justify-between gap-4 px-5 sm:gap-6 sm:px-6 md:px-10"
      >
        <a
          href="/"
          class="flex items-center gap-3 text-ink transition-colors duration-150 hover:text-accent"
        >
          <svg
            class="mark size-[22px] shrink-0 text-accent"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8.25"></circle>
            <circle cx="12" cy="12" r="2.3" data-solid></circle>
          </svg>
          <span
            class="font-display text-2xs font-semibold tracking-[0.12em] whitespace-nowrap uppercase font-stretch-[112%] sm:text-xs sm:tracking-[0.16em]"
            >{SITE_TITLE}</span
          >
        </a>

        <nav class="flex items-center gap-5 sm:gap-7">
          <a
            href="/blog/"
            class="font-display text-2xs font-medium tracking-[0.14em] whitespace-nowrap uppercase text-muted transition-colors duration-150 hover:text-ink sm:text-xs"
            >Writing</a
          >
          <a
            href="/about/"
            class="font-display text-2xs font-medium tracking-[0.14em] whitespace-nowrap uppercase text-muted transition-colors duration-150 hover:text-ink sm:text-xs"
            >About</a
          >
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div
        class="mx-auto flex max-w-shell flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-10 md:px-10 md:py-12"
      >
        <p class="label">{copyright}</p>
        <div class="flex items-center gap-7">
          <a href="/rss.xml" class="flex items-center gap-2.5 text-muted hover:text-accent">
            <svg
              class="mark size-[15px]"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="8.6" cy="15.6" r="1.35" data-solid></circle>
              <path d="M8.4 11.2a4.4 4.4 0 0 1 4.4 4.4"></path>
              <path d="M8.4 7.6a8 8 0 0 1 8 8"></path>
            </svg>
            <span
              class="font-display text-xs font-medium tracking-[0.14em] uppercase">RSS</span
            >
          </a>
          <a
            href={SOCIAL.instagram}
            rel="me noopener"
            class="font-display text-xs font-medium tracking-[0.14em] uppercase text-muted hover:text-accent"
            >Instagram</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
