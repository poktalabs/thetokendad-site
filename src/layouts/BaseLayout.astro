---
/*
  Base layout. The header is the command bar: one ruled pill with boxed
  cells (brand, the headline ticker when the page supplies one, nav).
*/
import BaseHead from '../components/BaseHead.astro';
import Ticker, { type TickerItem } from '../components/Ticker.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headlines?: TickerItem[];
  /** structured data for the page, one object or several; serialised verbatim */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, headlines = [], jsonLd } = Astro.props;
const hasTicker = headlines.length > 0;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {blocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="wrap relative z-10">
      <div class:list={['bar', { 'has-ticker': hasTicker }]}>
        <a href="/" class="cell brand">
          <Wordmark />
        </a>
        {hasTicker && (
          <div class="cell cell-ticker">
            <Ticker items={headlines} />
          </div>
        )}
        <nav class="cell nav" aria-label="Site">
          <a href="/lab/">Lab</a>
          <a href="/studio/">Studio</a>
          <a href="/blog/">Writing</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="wrap flex items-center justify-between border-t border-line py-6 text-sm text-ink">
      <p class="m-0">&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
      <a href="/rss.xml" class="no-underline hover:text-magenta">RSS</a>
    </footer>
  </body>
</html>

<style>
  .bar {
    display: grid;
    grid-template-columns: auto 1fr;
    margin-top: 1.25rem;
    border: 1px solid var(--color-sparkle);
    border-radius: var(--radius-pill);
    background: var(--color-ground);
    font-size: 0.9rem;
  }
  .bar.has-ticker { grid-template-columns: auto 1fr auto; }

  .cell {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 3.25rem;
    padding: 0 1.25rem;
  }
  .cell + .cell { border-left: 1px solid var(--color-sparkle); }

  .brand {
    text-decoration: none;
    border-radius: var(--radius-pill) 0 0 var(--radius-pill);
  }
  .brand:hover :global(.o) { transform: scale(1.2); }

  .nav {
    padding: 0;
    justify-self: end;
  }
  .nav a {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 1.25rem;
    color: var(--color-ink);
    text-decoration: none;
    border-left: 1px solid var(--color-sparkle);
    transition: background-color 200ms ease;
  }
  .nav a:first-child { border-left: 0; }
  .nav a:last-child { border-radius: 0 var(--radius-pill) var(--radius-pill) 0; }
  .nav a:hover { background: var(--color-ground-raised); color: var(--color-ink); }

  @media (max-width: 56rem) {
    /* no ticker: the brand cell takes the space up to the nav and centres the wordmark */
    .bar, .bar.has-ticker { grid-template-columns: 1fr auto; }
    .cell-ticker { display: none; }
    .brand { justify-content: center; }
    .nav a { padding: 0 0.9rem; }
  }
  @media (max-width: 26rem) {
    .cell { padding: 0 0.8rem; }
    .nav a { padding: 0 0.6rem; font-size: 0.8rem; }
  }
</style>
