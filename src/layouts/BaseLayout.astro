---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Which token is struck at the top of this page. */
  section?: 'home' | 'writing' | 'about' | 'post';
  /** Overrides the stamp inside that token. A post carries its own subject
      rather than a generic "post" mark, the way a metro station carries its
      own pictogram rather than a generic "station" one. */
  stamp?: string;
}

const { title, description, section = 'post', stamp } = Astro.props;
const plateStamp = stamp ?? section;
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body data-section={section}>
    <!-- The stamp vocabulary. Defined once, referenced everywhere. Ten marks
         on a 24-unit grid, built from the same five primitives — circle, dot,
         rule, square, diagonal — so they read as one language rather than as
         ten icons. Strokes inherit, which is what makes them theme-aware. -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <g id="s-home"><circle class="solid" cx="12" cy="12" r="4.2"></circle></g>
        <g id="s-writing"><path d="M4 8h16M4 12h16M4 16h10"></path></g>
        <g id="s-about"
          ><circle class="solid" cx="12" cy="5.4" r="1.6"></circle><path d="M12 10v9"></path></g
        >
        <g id="s-origin"
          ><path d="M5 3v16h16"></path><circle class="solid" cx="5" cy="19" r="2.5"></circle></g
        >
        <g id="s-route"
          ><path d="M6.6 12h3.4M14 12h3.4"></path><circle cx="4.4" cy="12" r="2.2"></circle><circle
            cx="12"
            cy="12"
            r="2.2"></circle><circle cx="19.6" cy="12" r="2.2"></circle></g
        >
        <g id="s-frame"><path d="M3 3h18v18H3z"></path><path d="M9 9h6v6H9z"></path></g>
        <g id="s-measure"><path d="M7 3v18"></path><path d="M7 6h11M7 12h7.5M7 18h4"></path></g>
        <g id="s-repair"><path d="M3 9h8"></path><path d="M13 15h8"></path><path d="M11 9l2 6"></path></g>
        <g id="s-mark"><path d="M12 3l9 9-9 9-9-9z"></path></g>
      </defs>
    </svg>

    <header class="masthead">
      <div class="shell">
        <a class="masthead-wordmark" href="/">
          <span class="token token--chip">
            <svg class="token-face" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <circle class="token-ring token-ring--still" cx="24" cy="24" r="21"></circle>
              <g
                class="token-stamp token-stamp--still"
                transform="translate(24 24) scale(1.25) translate(-12 -12)"
              >
                <use href="#s-home"></use>
              </g>
            </svg>
          </span>
          <span>{SITE_TITLE}</span>
        </a>
        <nav aria-label="Sections">
          <ul class="masthead-nav">
            <li>
              <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}
                >Writing</a
              >
            </li>
            <li>
              <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="shell">
        <!-- The wall label. Every page type opens the same way: the token is
             struck, then the name of the place, then one line of wall text. -->
        <div class="plate">
          <span class="token">
            <svg class="token-face" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <circle class="token-ring" cx="24" cy="24" r="21"></circle>
              <g class="token-stamp" transform="translate(24 24) scale(1.25) translate(-12 -12)">
                <use href={`#s-${plateStamp}`}></use>
              </g>
            </svg>
          </span>
          <slot name="plate" />
        </div>

        <slot />
      </div>
    </main>

    <footer class="colophon">
      <div class="shell">
        <div class="colophon-row">
          <span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
          <span aria-hidden="true">&middot;</span>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
