---
/*
  World: a planet that is also a gate. Each aspect of The Token Dad is a
  world; clicking it drops you into that part of the site.

  Shape carries the meaning, colour is scenery (the glyph rule):
    ring     a ringed planet         Writing (things published)
    moon     a planet with a moon    The Dad (the person, and who orbits him)
    craters  a cratered planet       Lab (experiments, marks left behind)

  The gradient runs in the sun's family (orange, magenta, violet), so every
  world reads as lit by the same star.
*/
type Kind = 'ring' | 'moon' | 'craters';

interface Props {
  href: string;
  label: string;
  hint?: string;
  kind: Kind;
  from?: string;
  to?: string;
  class?: string;
  delay?: number;
}
const {
  href,
  label,
  hint,
  kind,
  from = 'orange',
  to = 'magenta',
  class: className,
  delay = 0,
} = Astro.props;
const id = `world-${kind}-${Math.random().toString(36).slice(2, 7)}`;
---

<a href={href} class:list={['world', className]} style={`--delay:${delay}s`}>
  <span class="planet" aria-hidden="true">
    <svg viewBox="0 0 120 120" focusable="false">
      <defs>
        <linearGradient id={`${id}-g`} x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0" stop-color={`var(--color-${from})`} />
          <stop offset="1" stop-color={`var(--color-${to})`} />
        </linearGradient>
        <radialGradient id={`${id}-shade`} cx="0.32" cy="0.28" r="0.85">
          <stop offset="0.45" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.55" />
        </radialGradient>
      </defs>

      {kind === 'ring' && (
        <ellipse class="ring ring-back" cx="60" cy="60" rx="56" ry="14" transform="rotate(-18 60 60)" />
      )}

      <circle cx="60" cy="60" r="34" fill={`url(#${id}-g)`} />
      <circle cx="60" cy="60" r="34" fill={`url(#${id}-shade)`} />

      {kind === 'craters' && (
        <g fill="#000" opacity="0.28">
          <circle cx="47" cy="50" r="6" />
          <circle cx="68" cy="44" r="3.5" />
          <circle cx="70" cy="70" r="8" />
          <circle cx="50" cy="74" r="3" />
        </g>
      )}

      {kind === 'ring' && (
        <ellipse class="ring ring-front" cx="60" cy="60" rx="56" ry="14" transform="rotate(-18 60 60)" />
      )}

      {kind === 'moon' && (
        <g class="moon-orbit">
          <circle cx="60" cy="60" r="48" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="2 5" />
          <circle class="moon" cx="108" cy="60" r="6" />
        </g>
      )}
    </svg>
  </span>
  <span class="label">{label}</span>
  {hint && <span class="hint">{hint}</span>}
</a>

<style>
  .world {
    --size: clamp(72px, 7.5vw, 104px);

    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--color-ink);
    animation: float 7s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .planet {
    display: block;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    transition: transform 200ms ease, filter 200ms ease;
    filter: drop-shadow(0 0 18px rgb(255 47 214 / 0.25));
  }
  .planet svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--color-violet);
  }

  .ring {
    fill: none;
    stroke: var(--color-violet);
    stroke-width: 5;
    stroke-linecap: round;
  }
  /* the back half is hidden by the planet; drawing it thinner sells depth */
  .ring-back { stroke-opacity: 0.55; stroke-width: 4; }
  .ring-front {
    /* only the front half: dash the ellipse so the top arc is skipped */
    stroke-dasharray: 100 200;
    stroke-dashoffset: -60;
  }

  .moon { fill: var(--color-ink); }
  .moon-orbit {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: orbit 12s linear infinite;
    animation-delay: var(--delay);
  }

  .label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 200ms ease;
  }
  .hint {
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
  }

  .world:hover { color: var(--color-ink); }
  .world:hover .planet,
  .world:focus-visible .planet {
    transform: scale(1.08);
    filter: drop-shadow(0 0 32px rgb(255 47 214 / 0.55));
  }
  .world:hover .label { color: var(--color-magenta); }
  .world:focus-visible { outline: none; }
  .world:focus-visible .label { color: var(--color-magenta); text-decoration: underline; text-underline-offset: 0.25em; }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -6px; }
  }
  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .world, .moon-orbit { animation: none; }
    .planet { transition: none; }
  }
</style>
