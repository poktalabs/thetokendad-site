---
/*
  World: a gate into one aspect of The Token Dad, drawn as a colour card.
  Index, label, one line, and a plus. Colour is scenery: the three cards
  take the three palette hues by position, never by meaning.
*/
type Tone = 'orange' | 'magenta' | 'violet';

interface Props {
  href: string;
  index: string;
  label: string;
  hint?: string;
  tone: Tone;
  class?: string;
}
const { href, index, label, hint, tone, class: className } = Astro.props;
---

<a href={href} class:list={['world', tone, className]}>
  <span class="index">{index}</span>
  <span class="label">{label}</span>
  {hint && <span class="hint">{hint}</span>}
  <span class="plus" aria-hidden="true">+</span>
</a>

<style>
  .world {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.25rem;
    min-height: 15rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    color: var(--color-ground);
    text-decoration: none;
    transition: transform 250ms ease;
  }
  .world.orange { background: var(--color-orange); }
  .world.magenta { background: var(--color-magenta); }
  .world.violet { background: var(--color-violet); color: var(--color-ink); }

  .index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .label {
    align-self: start;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .hint {
    max-width: 22ch;
    padding-right: 3rem;
    font-size: 0.95rem;
    line-height: 1.4;
    opacity: 0.85;
  }
  .plus {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
  }

  .world:hover,
  .world:focus-visible {
    color: inherit;
    transform: translateY(-4px);
  }
  .world.violet:hover,
  .world.violet:focus-visible { color: var(--color-ink); }
  .world:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .world { transition: none; }
    .world:hover, .world:focus-visible { transform: none; }
  }
  @media (max-width: 48rem) {
    .world { min-height: 11rem; }
    .label { font-size: 1.6rem; }
  }
</style>
