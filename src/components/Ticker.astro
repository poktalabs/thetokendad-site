---
/*
  Ticker: the headline cell of the command bar. One line that cycles the
  latest transmissions (date and title), scrambling into cipher glyphs and
  resolving into the next one, then holding.

  Static-first: the first item is rendered server-side, so with no JS (or
  reduced motion) the line simply shows it.
*/
export interface TickerItem {
  when: string;
  what: string;
}

interface Props {
  items: TickerItem[];
  label?: string;
  class?: string;
}
const { items, label = 'Latest', class: className } = Astro.props;
const first = items[0];
---

{first && (
  <div class:list={['ticker', className]} data-ticker={JSON.stringify(items)} aria-live="off">
    <span class="ticker-label">{label}</span>
    <p class="ticker-line">
      <span class="ticker-when">{first.when}</span>
      <span class="ticker-what">{first.what}</span>
    </p>
  </div>
)}

<script>
  const GLYPHS = '#%&+=/<>[]{}|~^*:;0123456789ABCDEFΔΣΩ¤§';
  const HOLD_MS = 6000;
  const STEP_MS = 30;

  function scrambleTo(el: HTMLElement, next: string, done: () => void) {
    const from = el.textContent ?? '';
    const len = Math.max(from.length, next.length);
    let frame = 0;
    const total = Math.min(26, 10 + Math.floor(len / 3));
    const tick = () => {
      frame += 1;
      const resolved = Math.floor((frame / total) * next.length);
      let out = '';
      for (let i = 0; i < len; i += 1) {
        if (i < resolved) out += next[i] ?? '';
        else if (i < next.length) out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (frame < total) window.setTimeout(tick, STEP_MS);
      else { el.textContent = next; done(); }
    };
    tick();
  }

  function start(root: HTMLElement) {
    const items: { when: string; what: string }[] = JSON.parse(root.dataset.ticker ?? '[]');
    const when = root.querySelector<HTMLElement>('.ticker-when');
    const what = root.querySelector<HTMLElement>('.ticker-what');
    if (!when || !what || items.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    const next = () => {
      i = (i + 1) % items.length;
      when.textContent = items[i].when;
      scrambleTo(what, items[i].what, () => window.setTimeout(next, HOLD_MS));
    };
    window.setTimeout(next, HOLD_MS);
  }

  document.querySelectorAll<HTMLElement>('[data-ticker]').forEach(start);
</script>

<style>
  .ticker {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }
  .ticker-label {
    flex: none;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-magenta);
    color: var(--color-ground);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ticker-line {
    display: flex;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-ink-muted);
  }
  .ticker-when {
    flex: none;
    color: var(--color-ink-faint);
    text-transform: uppercase;
  }
  .ticker-what {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
