---
/*
  Home hero: the lab, alive.

  A big display statement on the left, over an ecosystem of nodes and
  travelling packets that fills the section. The wordmark lives in the
  command bar (Wordmark.astro), not here. Two pills under the statement:
  read the log, meet the dad.
*/
import Ecosystem from './Ecosystem.astro';
import SunMark from './SunMark.astro';

interface Props {
  statement: {
    word: string;
    tail: string;
    tailEmphasis: string;
    lineHead: string;
    lineEmphasis: string;
    line: string;
    emphasis: string;
  };
  lede: string;
}
const { statement, lede } = Astro.props;
/* the display word carries the sun as its O: split it around the first O */
const oAt = statement.word.indexOf('O');
const wordHead = statement.word.slice(0, oAt);
const wordTail = statement.word.slice(oAt + 1);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="field" aria-hidden="true">
    <Ecosystem />
  </div>

  <div class="deck wrap">
    <h1 id="hero-title" class="statement">
      <span class="line-1">
        <span class="sr-only">{statement.word}</span>
        <span class="word" aria-hidden="true">{wordHead}<SunMark size="0.7em" class="o" />{wordTail}</span>
      </span>
      <span class="line-2">{statement.tail} <span class="emphasis">{statement.tailEmphasis}</span></span>
      <span class="line-3">
        {statement.lineHead} <span class="emphasis">{statement.lineEmphasis}</span>{' '}
        {statement.line} <span class="emphasis">{statement.emphasis}</span>
      </span>
    </h1>
    <p class="lede">{lede}</p>

    <div class="actions">
      <a class="pill solid" href="/blog/">Read the log <span aria-hidden="true">&rarr;</span></a>
      <a class="pill" href="/about/">Who is building this</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  /* desktop: the hero takes the first screen minus the bar and a strip
     of the world cards, so their titles show above the fold */
  @media (min-width: 56rem) {
    .hero { min-height: calc(100svh - 4.5rem - 5.5rem); }
  }

  /* the ecosystem covers the section; faded where the copy sits */
  .field {
    position: absolute;
    inset: -2rem 0;
    z-index: 0;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.25) 0%, rgb(0 0 0 / 0.5) 45%, #000 70%);
  }

  .deck {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    padding-block: clamp(4rem, 10vh, 6rem) 4rem;
  }
  .deck > * { grid-column: 1; }
  .deck > .statement { grid-column: 1 / -1; }

  .statement {
    margin: 0;
    /* sized so TOKENMAXXING never breaks: about 7.6em of text on one line */
    font-size: clamp(1.5rem, 12vw - 0.25rem, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .line-1, .line-2, .line-3 { display: block; }
  .line-1 { white-space: nowrap; }
  .word { text-transform: uppercase; letter-spacing: -0.01em; }
  .word :global(.o) {
    display: inline-block;
    vertical-align: baseline;
    margin: 0 0.05em 0 0.02em;
  }
  .line-3 { max-width: 26ch; }
  .emphasis {
    background: var(--gradient-sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    max-width: 44ch;
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-ground);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .pill.solid {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ground);
  }
  .pill.solid:hover {
    background: var(--color-magenta);
    border-color: var(--color-magenta);
    color: var(--color-ground);
  }

  @media (max-width: 56rem) {
    .field { mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.3), #000); }
    .deck { grid-template-columns: 1fr; padding-block: 3rem 3rem; }
  }
</style>
