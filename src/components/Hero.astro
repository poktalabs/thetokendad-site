---
/*
  Home hero: arrival in a new universe.

  One star, the token, hangs at the top of the page. The wordmark sits in
  its lower light. Below, on a faint orbit arc, three worlds: each one is a
  gate into an aspect of The Token Dad, and each is a real link (the worlds
  ARE the primary navigation on the home page).

  Layers, back to front:
    nebula     violet and magenta washes on the graphite ground
    starfield  dotted depth layer, drifting
    sparkles   sparse four-point stars
    comet      a streak every so often
    sun        the token: gradient disc with horizontal cuts in its lower half
    content    wordmark, tagline
    orbit      the arc the worlds sit on, plus the worlds

  The wordmark is our own: Bowlby One, sun gradient, no outline, no slant,
  and the O in TOKEN is a small sun with the same cuts. Live text, with the
  full title exposed to assistive tech and the decorated version hidden
  from it.
*/
import Sparkles from './Sparkles.astro';
import StarField from './StarField.astro';
import World from './World.astro';

interface Props {
  title: string;
  tagline: string;
}
const { title, tagline } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <StarField />
    <Sparkles />
    <span class="comet"></span>
    <div class="sun"></div>
  </div>

  <div class="content wrap">
    <h1 id="hero-title" class="wordmark">
      <span class="sr-only">{title}</span>
      <span class="wordmark-art" aria-hidden="true">
        <span class="word">The</span>
        <span class="word">T<span class="sun-o"><span class="sun-o-disc"></span></span>ken</span>
        <span class="word">Dad</span>
      </span>
    </h1>

    <p class="tagline">{tagline}</p>
  </div>

  <nav class="orbit wrap" aria-label="Worlds">
    <svg class="orbit-arc" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M0 40 Q500 200 1000 40" />
    </svg>
    <p class="orbit-caption">Pick a world</p>
    <ul class="worlds">
      <li class="w w1">
        <World href="/blog/" label="Writing" hint="guides and posts" kind="ring" from="orange" to="magenta" delay={0} />
      </li>
      <li class="w w2">
        <World href="/about/" label="The Dad" hint="who is building this" kind="moon" from="coral" to="violet" delay={2.3} />
      </li>
      <li class="w w3">
        <World href="/website-challenge-v1/" label="Lab" hint="past experiments" kind="craters" from="magenta" to="violet-deep" delay={4.1} />
      </li>
    </ul>
  </nav>
</section>

<style>
  .hero {
    --sun-size: clamp(200px, 24vw, 340px);
    --sun-top: 3vh;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* run under the site header so the sky starts at the top of the page */
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    background:
      radial-gradient(70% 55% at 78% 6%,  rgb(139 61 255 / 0.22), transparent 70%),
      radial-gradient(55% 45% at 10% 40%, rgb(74 26 184 / 0.22), transparent 70%),
      radial-gradient(60% 40% at 50% 100%, rgb(255 47 214 / 0.10), transparent 70%),
      var(--color-ground);
  }

  /* ---- sky ---- */
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .sun {
    position: absolute;
    left: 50%;
    top: calc(var(--header-h) + var(--sun-top));
    width: var(--sun-size);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--gradient-sun-deep);
    box-shadow:
      0 0 80px rgb(255 77 109 / 0.35),
      0 0 220px rgb(139 61 255 / 0.28);
    /* the cuts: bands of sky through the lower half, widening downward */
    mask-image: linear-gradient(
      to bottom,
      #000 0 52%,
      transparent 52% 54%,
      #000 54% 61%,
      transparent 61% 64%,
      #000 64% 70%,
      transparent 70% 74%,
      #000 74% 79%,
      transparent 79% 84%,
      #000 84% 88%,
      transparent 88% 94%,
      #000 94% 97%,
      transparent 97%
    );
  }

  /* a comet streak every so often, top-right to mid-left */
  .comet {
    position: absolute;
    top: 14%;
    left: 70%;
    width: 180px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.9));
    transform: rotate(-24deg);
    opacity: 0;
    animation: comet 14s ease-in-out infinite;
    animation-delay: 3s;
  }
  @keyframes comet {
    0%, 6%   { opacity: 0; translate: 0 0; }
    1%       { opacity: 1; }
    5%       { opacity: 0; translate: -420px 190px; }
    100%     { opacity: 0; translate: -420px 190px; }
  }

  /* ---- content ---- */
  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    align-content: start;
    text-align: center;
    gap: 1rem;
    /* the wordmark starts just under the sun, in open sky, so the two never fight */
    padding-top: calc(var(--sun-top) + var(--sun-size) + 1.25rem);
  }

  /* ---- the wordmark ---- */
  .wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7.6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .wordmark-art {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
    filter:
      drop-shadow(0 0 22px rgb(255 77 109 / 0.35))
      drop-shadow(0 12px 22px rgb(0 0 0 / 0.55));
  }

  .word {
    background-image: var(--gradient-sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-block: 0.06em; /* keep descender room inside the clip box */
  }

  /* the O in TOKEN: a small sun, cuts included */
  .sun-o {
    display: inline-grid;
    place-items: center;
    width: 0.86em;
    height: 0.86em;
    vertical-align: -0.04em;
    margin-inline: 0.03em;
  }
  .sun-o-disc {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--gradient-sun);
    mask-image: linear-gradient(
      to bottom,
      #000 0 54%,
      transparent 54% 60%,
      #000 60% 72%,
      transparent 72% 79%,
      #000 79% 90%,
      transparent 90% 100%
    );
  }

  .tagline {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  /* ---- orbit + worlds ---- */
  .orbit {
    position: relative;
    z-index: 2;
    padding-block: 1.5rem 3rem;
  }

  .orbit-arc {
    position: absolute;
    left: -10%;
    right: -10%;
    width: 120%;
    top: 50%;
    height: 220px;
    translate: 0 -46%;
    fill: none;
    stroke: var(--color-violet);
    stroke-opacity: 0.35;
    stroke-width: 1;
    stroke-dasharray: 3 7;
    pointer-events: none;
  }

  .orbit-caption {
    margin: 0 0 1.25rem;
    text-align: center;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .worlds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    justify-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* follow the arc: the middle world sits lower */
  .w2 { translate: 0 30px; }

  @media (max-width: 48rem) {
    .hero { --sun-size: clamp(200px, 60vw, 280px); }
    .orbit { padding-block: 2rem 3rem; }
    .orbit-arc { height: 140px; }
    .w2 { translate: 0 22px; }
    .worlds :global(.hint) { display: none; }
    .worlds :global(.label) { font-size: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .comet { animation: none; }
  }
</style>
