---
/*
  Home hero: the quiet deck of a research station.

  Nothing shouts. A sparse starfield, a small sun emblem (the token), the
  station's name in tracked caps, one line of intent, and a signal line
  that decodes a transmission now and then. Under it, a readout row of
  station facts in mono. The worlds (the primary navigation) follow as a
  hairline strip.

  The full title is exposed to assistive tech; the decorated wordmark with
  the sun-O is hidden from it.
*/
import StarField from './StarField.astro';
import Signal from './Signal.astro';
import World from './World.astro';

interface Readout {
  label: string;
  value: string;
}

interface Props {
  title: string;
  tagline: string;
  signals: string[];
  readouts: Readout[];
}
const { title, tagline, signals, readouts } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <StarField />
  </div>

  <div class="deck wrap">
    <span class="emblem" aria-hidden="true"></span>

    <h1 id="hero-title" class="wordmark">
      <span class="sr-only">{title}</span>
      <span class="wordmark-art" aria-hidden="true">
        <span class="word">The</span>
        <span class="word">T<span class="sun-o"><span class="sun-o-disc"></span></span>ken</span>
        <span class="word">Dad</span>
      </span>
    </h1>

    <p class="tagline">{tagline}</p>

    <Signal messages={signals} class="hero-signal" />

    <dl class="readouts">
      {readouts.map((r) => (
        <div class="readout">
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <nav class="strip" aria-label="Worlds">
    <ul class="worlds wrap">
      <li><World href="/blog/" index="01" label="Writing" hint="Guides and posts, with receipts" kind="ring" /></li>
      <li><World href="/about/" index="02" label="The Dad" hint="Who is building this, and why" kind="moon" /></li>
      <li><World href="/website-challenge-v1/" index="03" label="Lab" hint="Experiments, including the closed ones" kind="crescent" /></li>
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* run under the site header so the sky starts at the top of the page */
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background:
      radial-gradient(60% 50% at 85% 0%, rgb(74 26 184 / 0.14), transparent 70%),
      var(--color-ground);
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* ---- the deck ---- */
  .deck {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vh, 8rem) 3.5rem;
  }

  /* the token: a small sun with the cuts, the station's emblem */
  .emblem {
    display: block;
    width: 44px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gradient-sun);
    box-shadow: 0 0 24px rgb(255 77 109 / 0.35);
    mask-image: linear-gradient(
      to bottom,
      #000 0 54%,
      transparent 54% 60%,
      #000 60% 72%,
      transparent 72% 79%,
      #000 79% 90%,
      transparent 90% 100%
    );
  }

  .wordmark {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .wordmark-art {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.55em;
  }

  /* the O in TOKEN, the same emblem at type size */
  .sun-o {
    display: inline-grid;
    place-items: center;
    width: 0.8em;
    height: 0.8em;
    vertical-align: -0.02em;
    margin-inline: 0.05em 0.2em;
  }
  .sun-o-disc {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--gradient-sun);
    mask-image: linear-gradient(
      to bottom,
      #000 0 54%,
      transparent 54% 62%,
      #000 62% 76%,
      transparent 76% 86%,
      #000 86% 100%
    );
  }

  .tagline {
    max-width: 40ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .hero :global(.hero-signal) {
    margin-top: 0.5rem;
  }

  /* ---- readouts ---- */
  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    width: 100%;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
  }
  .readout {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }
  .readout dt {
    color: var(--color-ink-faint);
    text-transform: uppercase;
  }
  .readout dd {
    margin: 0;
    color: var(--color-ink-muted);
  }

  /* ---- worlds strip ---- */
  .strip {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .worlds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .worlds li + li {
    border-left: 1px solid rgb(255 255 255 / 0.08);
  }

  @media (max-width: 48rem) {
    .deck { padding-block: 3rem 2.5rem; }
    .worlds { grid-template-columns: 1fr; }
    .worlds li + li {
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.08);
    }
  }
</style>
