---
/*
  Home hero: the lab, alive.

  A big display statement on the left, over an ecosystem of nodes and
  travelling packets that fills the section. The wordmark lives in the
  command bar (Wordmark.astro), not here. Two pills under the statement:
  read the log, meet the dad.
*/
import Ecosystem from './Ecosystem.astro';

interface Props {
  statement: string;
  lede: string;
}
const { statement, lede } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="field" aria-hidden="true">
    <Ecosystem />
  </div>

  <div class="deck wrap">
    <h1 id="hero-title" class="statement">{statement}</h1>
    <p class="lede">{lede}</p>

    <div class="actions">
      <a class="pill solid" href="/blog/">Read the log <span aria-hidden="true">&rarr;</span></a>
      <a class="pill" href="/about/">Who is building this</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* the ecosystem covers the section; faded where the copy sits */
  .field {
    position: absolute;
    inset: -2rem 0;
    z-index: 0;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.25) 0%, rgb(0 0 0 / 0.5) 45%, #000 70%);
  }

  .deck {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    padding-block: clamp(4rem, 10vh, 6rem) 4rem;
  }
  .deck > * { grid-column: 1; }

  .statement {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 44ch;
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-ground);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .pill.solid {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ground);
  }
  .pill.solid:hover {
    background: var(--color-magenta);
    border-color: var(--color-magenta);
    color: var(--color-ground);
  }

  @media (max-width: 56rem) {
    .field { mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.3), #000); }
    .deck { grid-template-columns: 1fr; padding-block: 3rem 3rem; }
  }
</style>
