---
/*
  Home hero: the lab, alive.

  A big display statement on the left, over an ecosystem of nodes and
  travelling packets that fills the section. The station name sits above
  the statement as a kicker with the sun as the O in TOKEN. Two pills
  under the statement: read the log, meet the dad.

  The full title is exposed to assistive tech; the decorated kicker is
  hidden from it.
*/
import Ecosystem from './Ecosystem.astro';

interface Props {
  title: string;
  statement: string;
  lede: string;
}
const { title, statement, lede } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="field" aria-hidden="true">
    <Ecosystem />
  </div>

  <div class="deck wrap">
    <p class="kicker">
      <span class="sr-only">{title}</span>
      <span class="kicker-art" aria-hidden="true">The T<span class="sun-o"></span>ken Dad</span>
    </p>

    <h1 id="hero-title" class="statement">{statement}</h1>
    <p class="lede">{lede}</p>

    <div class="actions">
      <a class="pill solid" href="/blog/">Read the log <span aria-hidden="true">&rarr;</span></a>
      <a class="pill" href="/about/">Who is building this</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* the ecosystem covers the section; faded where the copy sits */
  .field {
    position: absolute;
    inset: -2rem 0;
    z-index: 0;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.25) 0%, rgb(0 0 0 / 0.5) 45%, #000 70%);
  }

  .deck {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    padding-block: clamp(4rem, 10vh, 6rem) 4rem;
  }
  .deck > * { grid-column: 1; }

  .kicker {
    display: flex;
    align-items: center;
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .kicker-art { display: inline-flex; align-items: center; }

  /* the token: the sun with its cuts, as the O in TOKEN */
  .sun-o {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    margin: 0 0.2em 0 0.05em;
    border-radius: 50%;
    background: var(--gradient-sun);
    mask-image: linear-gradient(
      to bottom,
      #000 0 54%,
      transparent 54% 62%,
      #000 62% 76%,
      transparent 76% 86%,
      #000 86% 100%
    );
  }

  .statement {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 44ch;
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-ground);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .pill.solid {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ground);
  }
  .pill.solid:hover {
    background: var(--color-magenta);
    border-color: var(--color-magenta);
    color: var(--color-ground);
  }

  @media (max-width: 56rem) {
    .field { mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.3), #000); }
    .deck { grid-template-columns: 1fr; padding-block: 3rem 3rem; }
  }
</style>
