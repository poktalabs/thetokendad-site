---
/*
  Home hero: two columns. The statement, the lede and the two pills on the
  left; the projector on the right, an ecosystem of nodes that throws
  archive entries (log, lab, resources) onto a card display when a node is
  hovered, and cycles them on its own when left alone. The wordmark lives
  in the command bar (Wordmark.astro), not here.
*/
import Projector from './Projector.astro';
import SunMark from './SunMark.astro';
import type { ProjectorEntry } from '../lib/projector';

interface Props {
  statement: {
    word: string;
    tail: string;
    tailEmphasis: string;
    lineHead: string;
    lineEmphasis: string;
    line: string;
    emphasis: string;
  };
  lede: string;
  entries: ProjectorEntry[];
}
const { statement, lede, entries } = Astro.props;
/* the display word carries the sun as its O: split it around the first O */
const oAt = statement.word.indexOf('O');
const wordHead = statement.word.slice(0, oAt);
const wordTail = statement.word.slice(oAt + 1);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="deck wrap">
    <div class="copy">
      <h1 id="hero-title" class="statement">
        <span class="line-1">
          <span class="sr-only">{statement.word}</span>
          <span class="word" aria-hidden="true">{wordHead}<SunMark size="0.7em" class="o" />{wordTail}</span>
        </span>
        <span class="line-2">{statement.tail} <span class="emphasis">{statement.tailEmphasis}</span></span>
        <span class="line-3">
          {statement.lineHead} <span class="emphasis">{statement.lineEmphasis}</span>{' '}
          {statement.line} <span class="emphasis">{statement.emphasis}</span>
        </span>
      </h1>
      <p class="lede">{lede}</p>

      <div class="actions">
        <a class="pill solid" href="/blog/">Read the log <span aria-hidden="true">&rarr;</span></a>
        <a class="pill" href="/about/">Who is building this</a>
      </div>
    </div>

    <div class="stage">
      <Projector entries={entries} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  /* desktop: the hero takes the first screen minus the bar and a strip
     of the world cards, so their titles show above the fold */
  @media (min-width: 56rem) {
    .hero { min-height: calc(100svh - 4.5rem - 5.5rem); }
    .deck { min-height: inherit; }
  }

  .deck {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    column-gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3rem, 8vh, 5rem) 3.5rem;
  }
  /* the statement is sized against its own column, so it never breaks */
  .copy { container-type: inline-size; }

  .statement {
    margin: 0;
    /* TOKENMAXXING on one line: about 7.6em of text, 12.5cqw keeps it inside */
    font-size: clamp(1.5rem, 12.5cqw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .line-1, .line-2, .line-3 { display: block; }
  .line-1 { white-space: nowrap; }
  .word { text-transform: uppercase; letter-spacing: -0.01em; }
  .word :global(.o) {
    display: inline-block;
    vertical-align: baseline;
    margin: 0 0.05em 0 0.02em;
  }
  .line-3 { max-width: 26ch; }
  .emphasis {
    background: var(--gradient-sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    max-width: 44ch;
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-ground);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .pill.solid {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ground);
  }
  .pill.solid:hover {
    background: var(--color-magenta);
    border-color: var(--color-magenta);
    color: var(--color-ground);
  }

  /* the stage keeps the field's aspect and never outgrows the first screen */
  .stage {
    justify-self: end;
    width: min(100%, calc((100svh - 22rem) * 600 / 520));
    min-width: 16rem;
  }

  @media (max-width: 56rem) {
    .deck {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
      padding-block: 3rem 3rem;
    }
    .stage { justify-self: stretch; width: min(100%, 28rem); margin-inline: auto; }
  }
</style>
