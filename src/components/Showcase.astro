---
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';
import { EXHIBITS } from '../lib/exhibits';

/**
 * Showcase — the four exhibits, as a carousel.
 *
 * A browse-first teaser on the home page: one big preview at a time in a
 * scroll-snap track, a thumbnail strip below to jump between them, and a CTA
 * into the vote page where all four sit side by side and the ballot lives.
 *
 * No JavaScript. The track is a CSS scroll-snap container and the thumbnails
 * are ordinary anchor links to each slide's id — clicking one scrolls the
 * track to that slide. With no CSS scroll support it degrades to a plain
 * horizontally-scrollable row of links. The vote itself is on
 * /website-challenge-v1/vote/, not here.
 *
 * One signal accent for the section: Open — "work shown while it is still
 * wrong" — on the section head only.
 */
---

<section id="exhibits" class="shell stack-section" style="scroll-margin-top: 2rem">
  <div class="section-head">
    <Glyph name="open" size={18} style="color:var(--color-signal-open)" />
    <span class="label">The exhibits</span>
  </div>

  <div class="column showcase-intro">
    <p class="lede" style="text-align:center">
      One frozen brief, four AI design tools. All four converged on the same
      typeface. Browse what each one built, then vote for the one you'd ship.
    </p>
  </div>

  <div class="carousel">
    <div class="carousel-track">
      {
        EXHIBITS.map((e) => (
          <a
            id={`slide-${e.slug}`}
            class="carousel-slide"
            href={e.url}
            rel="noopener"
          >
            <Image src={e.image} alt={`The ${e.tool} exhibit`} width={1200} densities={[1, 1.5]} />
            <span class="carousel-caption meta meta-row">
              <span>{e.arm}</span>
              <span class="sep" aria-hidden="true">/</span>
              <span>{e.tool}</span>
              <span class="sep" aria-hidden="true">/</span>
              <span class="carousel-caption-cta">Visit ↗</span>
            </span>
          </a>
        ))
      }
    </div>

    <ul class="carousel-thumbs">
      {
        EXHIBITS.map((e) => (
          <li>
            <a class="carousel-thumb" href={`#slide-${e.slug}`} aria-label={`Show ${e.tool}`}>
              <Image src={e.image} alt="" width={320} />
              <span class="carousel-thumb-label label">{e.tool}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="center-row showcase-cta">
    <a class="cta-button" href="/website-challenge-v1/vote/">
      <span>Compare all four &amp; vote</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>
