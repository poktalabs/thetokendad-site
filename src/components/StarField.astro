---
/*
  Dotted starfield: the depth layer behind the sparkles. Two densities of
  tiny points, drifting on slow loops so the sky feels like it has distance.
  Positions come from a seeded generator, so the sky is the same on every
  build. Decorative only (aria-hidden).
*/
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

/* tiny LCG: deterministic "random" in [0, 1) */
function seeded(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(1664525, s) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

type Dot = { x: number; y: number; r: number; o: number };
function field(seed: number, count: number, rMin: number, rMax: number): Dot[] {
  const rnd = seeded(seed);
  return Array.from({ length: count }, () => ({
    x: Math.round(rnd() * 1000),
    y: Math.round(rnd() * 640),
    r: +(rMin + rnd() * (rMax - rMin)).toFixed(2),
    o: +(0.35 + rnd() * 0.65).toFixed(2),
  }));
}

const far = field(7, 110, 0.6, 1.2);
const near = field(19, 40, 1.3, 2.2);
---

<svg
  class:list={['starfield', className]}
  viewBox="0 0 1000 640"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="layer far">
    {far.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="#fff" opacity={d.o} />)}
  </g>
  <g class="layer near">
    {near.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="#fff" opacity={d.o} />)}
  </g>
</svg>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .layer {
    transform-box: view-box;
    animation: drift linear infinite;
  }
  .far  { animation-duration: 90s; opacity: 0.55; }
  .near { animation-duration: 60s; opacity: 0.8; }

  @keyframes drift {
    from { transform: translateX(0); }
    to   { transform: translateX(-12px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer { animation: none; }
  }
</style>
