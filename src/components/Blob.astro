---
/*
  Troopie: one piece of the brand chrome. A stepped, rounded silhouette in
  the reference frame's idiom, filled with a two-stop gradient from the
  decorative spectrum, with the frame's `''` eyes. Purely decorative; it
  never carries UI meaning.

  Three silhouettes so a group reads as a crowd, not clones:
    stack  three rounded blocks fused, stepping up to the right (the default)
    tall   a pillar with one shoulder
    wide   a low, broad block with a bump

  Troopies are alive: gooey enough to breathe, squash and settle, firm
  enough to hold their silhouette. The body breathes on a slow loop, the
  eyes blink on a separate, slower loop, and a faint side-to-side lean makes
  the two loops feel unscripted. `delay` offsets the loops so Troopies on
  the same page never move in sync. All of it stops under
  prefers-reduced-motion.

  `from` / `to` take theme colour names (lime, yellow, cyan, blue, orange,
  pink, magenta, purple). Position it from the parent via `class`.
*/
type Variant = 'stack' | 'tall' | 'wide';

interface Props {
  from?: string;
  to?: string;
  variant?: Variant;
  class?: string;
  eyes?: boolean;
  delay?: number;
  flip?: boolean;
}
const {
  from = 'magenta',
  to = 'purple',
  variant = 'stack',
  class: className,
  eyes = true,
  delay = 0,
  flip = false,
} = Astro.props;

/* all silhouettes sit on the baseline y=200 in a 200x200 box */
const shapes: Record<Variant, { d: string; eyes: [number, number] }> = {
  stack: {
    d: 'M40 200 V110 a30 30 0 0 1 30 -30 h20 V50 a30 30 0 0 1 30 -30 h50 a30 30 0 0 1 30 30 V200 Z',
    eyes: [148, 44],
  },
  tall: {
    d: 'M70 200 V40 a34 34 0 0 1 34 -34 h30 a34 34 0 0 1 34 34 V120 h10 a22 22 0 0 1 22 22 V200 Z',
    eyes: [116, 30],
  },
  wide: {
    d: 'M10 200 V126 a30 30 0 0 1 30 -30 h50 V80 a26 26 0 0 1 26 -26 h34 a26 26 0 0 1 26 26 V96 h10 a30 30 0 0 1 30 30 V200 Z',
    eyes: [122, 76],
  },
};
const shape = shapes[variant];
const id = `troopie-${from}-${to}-${variant}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class:list={['troopie', className, { flip }]}
  viewBox="0 0 200 200"
  aria-hidden="true"
  focusable="false"
  style={`--delay:${delay}s`}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={`var(--color-${from})`} />
      <stop offset="1" stop-color={`var(--color-${to})`} />
    </linearGradient>
  </defs>
  <g class="body">
    <path fill={`url(#${id})`} d={shape.d} />
    {eyes && (
      <g
        class="eyes"
        fill="var(--color-ground)"
        transform={`translate(${shape.eyes[0]} ${shape.eyes[1]}) skewX(-14)`}
      >
        <rect x="0" y="0" width="5" height="16" rx="2.5" />
        <rect x="12" y="0" width="5" height="16" rx="2.5" />
      </g>
    )}
  </g>
</svg>

<style>
  .troopie {
    position: absolute;
    pointer-events: none;
    overflow: visible;
  }
  .troopie.flip {
    transform: scaleX(-1);
  }

  /* the body squashes from its feet: wider as it settles, taller as it rises */
  .body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation:
      breathe 4.6s ease-in-out infinite,
      lean 9s ease-in-out infinite;
    animation-delay: var(--delay), calc(var(--delay) * 1.5);
  }

  /* eyes: a quick double-blink, then a long hold */
  .eyes {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: blink 6.2s step-end infinite;
    animation-delay: calc(var(--delay) + 1.3s);
  }

  @keyframes breathe {
    0%, 100% { transform: scale(1, 1); }
    45%      { transform: scale(0.97, 1.045); }
    60%      { transform: scale(1.02, 0.975); }
  }

  @keyframes lean {
    0%, 100% { rotate: 0deg; }
    30%      { rotate: -1.6deg; }
    70%      { rotate: 1.2deg; }
  }

  @keyframes blink {
    0%, 100%    { transform: scaleY(1); }
    3%          { transform: scaleY(0.08); }
    5%          { transform: scaleY(1); }
    8%          { transform: scaleY(0.08); }
    10%         { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .body, .eyes { animation: none; }
  }
</style>
