---
/*
  Signal line: the station picks up a transmission every so often. A mono
  line that scrambles into cipher glyphs and resolves into the next
  message, then holds. Messages come from the page (latest entries,
  station facts), so the effect is decoration on real information.

  Static-first: the first message is rendered server-side, so with no JS
  (or reduced motion) the line simply shows it.
*/
interface Props {
  messages: string[];
  class?: string;
}
const { messages, class: className } = Astro.props;
const first = messages[0] ?? '';
---

<p class:list={['signal', className]} data-signal={JSON.stringify(messages)} aria-live="off">
  <span class="signal-prompt" aria-hidden="true">&gt;</span>
  <span class="signal-text">{first}</span>
  <span class="signal-cursor" aria-hidden="true"></span>
</p>

<script>
  const GLYPHS = '#%&+=/<>[]{}|~^*:;0123456789ABCDEFΔΣΩ¤§';
  const HOLD_MS = 9000;
  const STEP_MS = 34;

  function scrambleTo(el: HTMLElement, next: string, done: () => void) {
    const from = el.textContent ?? '';
    const len = Math.max(from.length, next.length);
    let frame = 0;
    const total = Math.min(28, 10 + Math.floor(len / 2));
    const tick = () => {
      frame += 1;
      const resolved = Math.floor((frame / total) * next.length);
      let out = '';
      for (let i = 0; i < len; i += 1) {
        if (i < resolved) out += next[i] ?? '';
        else if (i < next.length) out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (frame < total) window.setTimeout(tick, STEP_MS);
      else { el.textContent = next; done(); }
    };
    tick();
  }

  function start(root: HTMLElement) {
    const messages: string[] = JSON.parse(root.dataset.signal ?? '[]');
    const text = root.querySelector<HTMLElement>('.signal-text');
    if (!text || messages.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    const next = () => {
      i = (i + 1) % messages.length;
      scrambleTo(text, messages[i], () => window.setTimeout(next, HOLD_MS));
    };
    window.setTimeout(next, HOLD_MS);
  }

  document.querySelectorAll<HTMLElement>('[data-signal]').forEach(start);
</script>

<style>
  .signal {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
  }
  .signal-prompt { color: var(--color-magenta); }
  .signal-text { min-height: 1lh; }
  .signal-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    translate: 0 0.15em;
    background: var(--color-ink-muted);
    opacity: 0.7;
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) {
    .signal-cursor { animation: none; }
  }
</style>
