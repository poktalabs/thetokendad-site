---
/*
  FAQ: a ruled list of questions that open one at a time. Each item takes
  a palette tone by position (never by meaning): the index readout, the
  plus, and the rule that appears when the item is open. That is the
  colour the reading surfaces were missing; it stays out of the text.

  Use anywhere: pages (`<FAQ items={...} heading="..." />`) or MDX posts
  (`import FAQ from '../../components/FAQ.astro'`). Pair with `faqJsonLd`
  from `lib/faq.ts` through the layout's `jsonLd` prop when the page
  should carry FAQPage structured data.
*/
import type { FaqItem } from '../lib/faq';

interface Props {
  items: FaqItem[];
  /** mono readout above the heading; defaults to FAQ */
  label?: string;
  heading?: string;
  lede?: string;
  class?: string;
}
const { items, label = 'FAQ', heading, lede, class: className } = Astro.props;

const tones = ['orange', 'magenta', 'violet', 'coral'];
const group = `faq-${Math.random().toString(36).slice(2, 7)}`;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['faq', className]} aria-label={heading ?? label}>
  <header class="faq-head">
    <p class="faq-label">{label}</p>
    {heading && <h2 class="faq-heading">{heading}</h2>}
    {lede && <p class="faq-lede">{lede}</p>}
  </header>

  <ol class="faq-list">
    {items.map((item, i) => (
      <li class="faq-item" style={`--tone: var(--color-${tones[i % tones.length]})`}>
        <details name={group}>
          <summary>
            <span class="faq-index" aria-hidden="true">{pad(i + 1)}</span>
            <span class="faq-q">{item.q}</span>
            <span class="faq-plus" aria-hidden="true">+</span>
          </summary>
          <div class="faq-a">
            {item.html ? <Fragment set:html={item.html} /> : <p>{item.a}</p>}
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .faq-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .faq-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .faq-heading {
    margin: 0.75rem 0 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
  }
  .faq-lede {
    max-width: 44ch;
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .faq-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .faq-item {
    position: relative;
    border-bottom: 1px solid var(--color-line);
  }
  /* the tone rule: hidden until the item opens */
  .faq-item::before {
    content: '';
    position: absolute;
    top: 0.9rem;
    bottom: 0.9rem;
    left: -1rem;
    width: 2px;
    border-radius: 1px;
    background: var(--tone);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .faq-item:has(details[open])::before { opacity: 1; }

  summary {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 1.75rem;
    align-items: center;
    column-gap: 0.75rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible {
    outline: 2px solid var(--tone);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--tone);
  }
  .faq-q {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    text-wrap: pretty;
    transition: color 200ms ease;
  }
  summary:hover .faq-q { color: var(--tone); }
  .faq-plus {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-ink);
    transition: transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 200ms ease, color 200ms ease, background-color 200ms ease;
  }
  summary:hover .faq-plus { border-color: var(--tone); color: var(--tone); }
  details[open] .faq-plus {
    transform: rotate(45deg);
    border-color: var(--tone);
    background: var(--tone);
    color: var(--color-ground);
  }

  .faq-a {
    padding: 0 2.5rem 1.25rem 3rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .faq-a :global(p) { margin: 0; }
  .faq-a :global(p + p) { margin-top: 0.75em; }
  .faq-a :global(a) { text-decoration: underline; }

  @media (max-width: 40rem) {
    .faq-item::before { left: -0.6rem; }
    summary { grid-template-columns: 1.75rem minmax(0, 1fr) 1.6rem; padding: 0.95rem 0; }
    .faq-q { font-size: 1rem; }
    .faq-a { padding: 0 0 1.1rem 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::before, .faq-q, .faq-plus { transition: none; }
  }
</style>
