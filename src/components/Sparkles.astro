---
/*
  Sparkle field: the grey four-point stars from the reference frame, kept
  sparse and quiet so they read as ambient depth, not decoration competing
  with the wordmark. Decorative only (aria-hidden). Positions are a fixed
  constellation, not random, so the hero renders the same on every build.
  Sizes in viewBox units (1000 x 600); `big` ones get the slow twinkle.
*/
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

type Star = { x: number; y: number; s: number; big?: boolean; delay?: number };
const stars: Star[] = [
  { x: 820, y: 70, s: 16, big: true, delay: 0.6 },
  { x: 690, y: 150, s: 7 },
  { x: 940, y: 215, s: 9 },
  { x: 120, y: 470, s: 22, big: true, delay: 2.4 },
  { x: 300, y: 545, s: 7 },
  { x: 560, y: 520, s: 10 },
];

/* four-point star, centred at 0,0 with radius 1; concave sides via quad curves */
const path = 'M0 -1 Q0.06 -0.06 1 0 Q0.06 0.06 0 1 Q-0.06 0.06 -1 0 Q-0.06 -0.06 0 -1 Z';
---

<svg
  class:list={['sparkles', className]}
  viewBox="0 0 1000 600"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {stars.map(({ x, y, s, big, delay }) => (
    <path
      d={path}
      fill="var(--color-sparkle)"
      transform={`translate(${x} ${y}) scale(${s})`}
      class:list={{ twinkle: big }}
      style={delay ? `animation-delay:${delay}s` : undefined}
    />
  ))}
</svg>

<style>
  .sparkles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }

  .twinkle {
    transform-box: fill-box;
    transform-origin: center;
    animation: twinkle 7s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .twinkle { animation: none; }
  }
</style>
