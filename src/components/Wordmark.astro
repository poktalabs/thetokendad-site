---
/*
  The wordmark: THE TOKEN DAD in tracked display caps, the sun mark as the
  O in TOKEN. Text is exposed once to assistive tech; the art is hidden.
*/
import SunMark from './SunMark.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <span class="sr-only">{SITE_TITLE}</span>
  <span class="art" aria-hidden="true">The T<SunMark size="0.7em" class="o" />ken Dad</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .art {
    display: inline-block;
    margin-right: -0.125em; /* cancel the tracking after the last letter */
  }
  /* the O: sized to the cap height of Bricolage (0.66em, plus a touch of
     round overshoot) and sat on the baseline so it reads as a letter */
  .art :global(.o) {
    display: inline-block;
    vertical-align: baseline;
    margin: 0 0.14em 0 0.02em;
    transition: transform 200ms ease;
  }
  @media (max-width: 26rem) {
    .wordmark { font-size: 0.75rem; letter-spacing: 0.1em; }
  }
</style>
