---
/*
  Studio: launched projects, the portfolio. One colour card per project,
  newest first, from STUDIO_PROJECTS in consts.ts.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import World from '../../components/World.astro';
import { SITE_TITLE, STUDIO_PROJECTS } from '../../consts';

const tones = ['magenta', 'violet', 'coral', 'orange'] as const;
---

<BaseLayout title={`Studio · ${SITE_TITLE}`} description="Launched projects from The Token Dad, with what each one cost.">
  <section class="page-head wrap">
    <h1>Studio</h1>
    <p class="page-lede">Launched projects. Things that shipped and are in use, with what each one cost to build.</p>
  </section>

  <section class="block wrap" aria-label="Launched projects">
    <div class="cards">
      {STUDIO_PROJECTS.map((p, i) => (
        <World href={p.href} eyebrow={`${p.status} · ${p.when}`} label={p.title} hint={p.line} tone={tones[i % tones.length]} compact plain />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .block { padding-block: 1rem 5rem; }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (max-width: 56rem) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
