---
/* Font comparison sheet, 2026-09-27. Delete once a stack is chosen. */
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/commit-mono/400.css';
import '@fontsource/commit-mono/700.css';
import '@fontsource-variable/archivo';
import '@fontsource-variable/figtree';
import '@fontsource-variable/martian-mono';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/instrument-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const stacks = [
  { id: 'now', name: 'Current: Space Grotesk, Inter, JetBrains Mono', d: "'Space Grotesk Variable'", s: "'Inter Variable'", m: "'JetBrains Mono Variable'" },
  { id: 'a', name: 'A: Bricolage Grotesque, Hanken Grotesk, Commit Mono', d: "'Bricolage Grotesque Variable'", s: "'Hanken Grotesk Variable'", m: "'Commit Mono'" },
  { id: 'b', name: 'B: Archivo, Figtree, Martian Mono', d: "'Archivo Variable'", s: "'Figtree Variable'", m: "'Martian Mono Variable'" },
  { id: 'c', name: 'C: Schibsted Grotesk, Instrument Sans, IBM Plex Mono', d: "'Schibsted Grotesk Variable'", s: "'Instrument Sans Variable'", m: "'IBM Plex Mono'" },
];
---

<html lang="en">
  <head><meta charset="utf-8" /><title>Font sheet</title><meta name="robots" content="noindex" /></head>
  <body>
    {stacks.map((k) => (
      <section class="stack" style={`--font-display:${k.d};--font-sans:${k.s};--font-mono:${k.m}`}>
        <p class="sheet-label">{k.name}</p>
        <div class="bar">
          <span class="brand"><span class="disc"></span>thetoken.dad</span>
          <span class="tick"><span class="pill">LATEST</span><span class="when">2026-08-07</span><span class="what">Why I'm building this in public</span></span>
          <span class="nav"><span>Writing</span><span>About</span><span>Lab</span></span>
        </div>
        <p class="kicker">THE T<span class="o"></span>KEN DAD</p>
        <h1 class="statement">A dad's lab for building with machines, published with receipts.</h1>
        <p class="lede">Guides you can replicate, experiments that sometimes fail, and every peso it costs. Updated from the bench.</p>
        <div class="row">
          <span class="card orange"><span class="label">Writing</span><span class="hint">Guides and posts, with receipts</span></span>
          <span class="feed">
            <span class="when">2026-08-07</span>
            <span class="kind">POST</span>
            <span class="t"><b>Why I'm building this in public</b>I forget things. I got tired of apologizing for it, so I started handing the remembering to machines, and publishing every peso it costs.</span>
          </span>
        </div>
        <p class="body">Body at reading size, 17px. Most hosting comparisons are written from pricing pages. I wrote this one from two deploys. The conclusion is boring: I picked Cloudflare. What is interesting is everything the exercise turned up that no amount of documentation reading would have. <code>bun run build</code> and a quote: "the same build produced two different sets of URLs".</p>
      </section>
    ))}
  </body>
</html>

<style>
  body { margin: 0; padding: 2rem; display: grid; gap: 3rem; }
  .stack { max-width: 72rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--color-line); }
  .sheet-label { margin: 0 0 1rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-faint); }
  .bar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; border: 1px solid var(--color-line); border-radius: 999px; font-size: 0.9rem; }
  .bar > * { display: flex; align-items: center; height: 3.25rem; padding: 0 1.25rem; }
  .bar > * + * { border-left: 1px solid var(--color-line); }
  .brand { gap: 0.6rem; font-weight: 600; }
  .disc { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--gradient-sun); }
  .tick { gap: 0.9rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-ink-muted); min-width: 0; }
  .pill { padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--color-magenta); color: var(--color-ground); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; }
  .what { color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nav { padding: 0; }
  .nav span { padding: 0 1.25rem; border-left: 1px solid var(--color-line); height: 100%; display: flex; align-items: center; }
  .nav span:first-child { border-left: 0; }
  .kicker { margin: 2rem 0 1rem; font-family: var(--font-display); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.22em; color: var(--color-ink-muted); }
  .o { display: inline-block; width: 0.85em; height: 0.85em; margin: 0 0.2em 0 0.05em; border-radius: 50%; background: var(--gradient-sun); vertical-align: -0.08em; }
  .statement { max-width: 20ch; margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 3.6rem; line-height: 1; letter-spacing: -0.03em; }
  .lede { max-width: 44ch; margin: 1.25rem 0 0; font-size: 1.15rem; line-height: 1.55; color: var(--color-ink-muted); }
  .row { display: grid; grid-template-columns: 18rem 1fr; gap: 1.5rem; margin-top: 2rem; align-items: start; }
  .card { display: grid; grid-template-rows: 1fr auto; min-height: 11rem; padding: 1.25rem 1.5rem; border-radius: 1.25rem; background: var(--color-orange); color: var(--color-ground); }
  .label { font-family: var(--font-display); font-weight: 700; font-size: 2rem; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; }
  .hint { font-size: 0.95rem; line-height: 1.3; max-width: 16ch; }
  .feed { display: grid; grid-template-columns: 7.5rem 5rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .feed .when { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-ink-muted); }
  .kind { justify-self: start; align-self: start; padding: 0.1rem 0.6rem; border: 1px solid var(--color-line-strong); border-radius: 999px; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--color-ink-muted); }
  .t { display: grid; gap: 0.35rem; color: var(--color-ink-muted); max-width: 60ch; }
  .t b { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: var(--color-ink); }
  .body { max-width: 65ch; margin: 1.5rem 0 0; }
  .body code { font-family: var(--font-mono); font-size: 0.9em; color: var(--color-magenta); }
</style>
