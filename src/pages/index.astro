---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import World from '../components/World.astro';
import Feed from '../components/Feed.astro';
import { getPublishedPosts } from '../lib/posts';
import { projectorEntries } from '../lib/projector';
import { SITE_TITLE, SITE_DESCRIPTION, HOME_STATEMENT, HOME_LEDE } from '../consts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
const entries = projectorEntries(posts);

const iso = (d: Date) => d.toISOString().slice(0, 10);

/* the command bar ticker: real transmissions, newest first */
const headlines = [
  ...latest.slice(0, 3).map((p) => ({ when: iso(p.data.pubDate), what: p.data.title })),
  { when: 'lab', what: 'website-challenge-v1 closed, four exhibits archived' },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} headlines={headlines}>
  <Hero statement={HOME_STATEMENT} lede={HOME_LEDE} entries={entries} />

  <nav class="worlds wrap" aria-label="Worlds">
    <World href="/blog/" label="Writing" hint="Guides and posts, with receipts" tone="orange" />
    <World href="/about/" label="The Dad" hint="Who is building this, and why" tone="magenta" />
    <World href="/website-challenge-v1/" label="Lab" hint="Experiments, including the closed ones" tone="violet" />
  </nav>

  <Feed posts={latest} />
</BaseLayout>

<style>
  .worlds {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 56rem) {
    .worlds { grid-template-columns: 1fr; }
  }
</style>
