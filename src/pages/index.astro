---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Feed from '../components/Feed.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);

const iso = (d: Date) => d.toISOString().slice(0, 10);
const firstLight = posts.length ? iso(posts[posts.length - 1].data.pubDate) : '2026-08-07';

/* the station's transmissions: real facts, cycled by the signal line */
const signals = [
  `station online since ${firstLight}`,
  ...latest.slice(0, 3).map((p) => `${iso(p.data.pubDate)} · ${p.data.title}`),
  'experiment website-challenge-v1 · closed · archived',
];

const readouts = [
  { label: 'Station', value: 'thetoken.dad' },
  { label: 'Orbit', value: 'CDMX' },
  { label: 'Since', value: firstLight },
  { label: 'Signals', value: String(posts.length).padStart(2, '0') },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero title={SITE_TITLE} tagline={SITE_DESCRIPTION} signals={signals} readouts={readouts} />
  <Feed posts={latest} />
</BaseLayout>
