---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero title={SITE_TITLE} tagline={SITE_DESCRIPTION} />

  <section class="wrap-prose py-16">
    <h2 class="mb-6 text-3xl">Writing</h2>
    {posts.length === 0 ? (
      <p class="text-ink-muted">Nothing published yet.</p>
    ) : (
      <ul class="m-0 list-none space-y-6 p-0">
        {posts.map((post) => (
          <li class="border-b border-line pb-6">
            <a href={`/blog/${post.id}/`} class="text-lg font-semibold no-underline hover:text-magenta">
              {post.data.title}
            </a>
            <p class="my-1 text-sm text-ink-faint"><FormattedDate date={post.data.pubDate} /></p>
            <p class="m-0 text-ink-muted">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
    <a href="/blog/" class="mt-6 inline-block font-medium">All writing</a>
  </section>
</BaseLayout>
