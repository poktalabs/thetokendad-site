---
/*
  Palette sheet (sketch, not to ship). The locked tokens from global.css
  plus proposed additions, with WCAG contrast printed next to each pair.
*/
import '../styles/global.css';

const lum = (hex: string) => {
  const h = hex.replace('#', '');
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  const f = (c: number) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
};
const cr = (a: string, b: string) => {
  const la = lum(a), lb = lum(b);
  return ((Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)).toFixed(2);
};

const ground = '#1c1c1c';
const ink = '#f2f2f2';

const locked = {
  ground: ['#1c1c1c', '#232323', '#2a2a2a', '#383838', '#4a4a4a'],
  inkSteps: [['ink', '#f2f2f2'], ['ink-muted', '#a8a8a8'], ['ink-faint', '#6e6e6e']],
  primary: [['orange', '#ff7a1f'], ['coral', '#ff4d6d'], ['magenta', '#ff2fd6'], ['magenta-deep', '#c400a3']],
  secondary: [['violet', '#8b3dff'], ['violet-deep', '#4a1ab8'], ['space', '#2a1650']],
};

// proposed additions
const proposed = {
  // a text-safe step of the secondary: violet as it is fails on ground (3.42)
  violetBright: ['violet-bright', '#b08cff'],
  // surfaces: the same hues pulled toward the ground so cards read as material, not signal
  surfaces: [['orange-surface', '#e8702a'], ['coral-surface', '#e04a68'], ['magenta-surface', '#d92fb8'], ['violet-surface', '#7a3ae0']],
  // a warm ink for text on the warm cards, instead of pure graphite
  inkOnWarm: ['ink-on-warm', '#2a1208'],
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>palette sheet</title>
</head>
<body>
  <main class="wrap">
    <h1>Palette sheet</h1>
    <p class="note">Locked tokens (2026-09-24) on top, proposed additions below. Numbers are WCAG contrast ratios against the surface each swatch sits on. 4.5 is AA for body text, 3 for large text and UI.</p>

    <h2>Ground steps</h2>
    <div class="row">
      {locked.ground.map((h, i) => (
        <div class="sw" style={`background:${h}`}><span>{['ground', 'raised', 'panel', 'line', 'line-strong'][i]}</span><code>{h}</code></div>
      ))}
    </div>

    <h2>Ink on ground</h2>
    <div class="row">
      {locked.inkSteps.map(([n, h]) => (
        <div class="sw" style={`background:${ground};color:${h}`}><span>{n}</span><code>{h}</code><b>{cr(h, ground)}</b></div>
      ))}
    </div>

    <h2>Primary: the sun</h2>
    <div class="row">
      <div class="sw tall" style="background: var(--gradient-sun)"><span>gradient-sun</span></div>
      {locked.primary.map(([n, h]) => (
        <div class="sw" style={`background:${ground};color:${h}`}><span>{n}</span><code>{h}</code><b>{cr(h, ground)}</b></div>
      ))}
    </div>

    <h2>Secondary: violet</h2>
    <div class="row">
      {locked.secondary.map(([n, h]) => (
        <div class="sw" style={`background:${ground};color:${h}`}><span>{n}</span><code>{h}</code><b>{cr(h, ground)}</b></div>
      ))}
      <div class="sw proposed" style={`background:${ground};color:${proposed.violetBright[1]}`}><span>{proposed.violetBright[0]}</span><code>{proposed.violetBright[1]}</code><b>{cr(proposed.violetBright[1], ground)}</b></div>
    </div>

    <h2>Text on colour: full saturation (as in the sketch)</h2>
    <div class="row">
      {[...locked.primary.slice(0, 3), locked.secondary[0]].map(([n, h]) => {
        const fg = n === 'violet' ? ink : ground;
        return (
          <div class="card" style={`background:${h};color:${fg}`}>
            <span class="idx">01</span>
            <span class="label">{n}</span>
            <span class="hint">Guides and posts, with receipts</span>
            <b>{fg === ink ? 'ink' : 'ground'} {cr(fg, h)}</b>
          </div>
        );
      })}
    </div>

    <h2>Text on colour: surface tints (proposed)</h2>
    <div class="row">
      {proposed.surfaces.map(([n, h]) => {
        const fg = n.startsWith('violet') ? ink : proposed.inkOnWarm[1];
        return (
          <div class="card" style={`background:${h};color:${fg}`}>
            <span class="idx">01</span>
            <span class="label">{n.replace('-surface', '')}</span>
            <span class="hint">Guides and posts, with receipts</span>
            <b>{fg === ink ? 'ink' : 'ink-on-warm'} {cr(fg, h)}</b>
          </div>
        );
      })}
    </div>

    <h2>Signal colours on ground (packets, ticker, hover)</h2>
    <div class="row">
      {[...locked.primary.slice(0, 3), locked.secondary[0], proposed.violetBright].map(([n, h]) => (
        <div class="sw" style={`background:${ground}`}>
          <i style={`background:${h};box-shadow:0 0 12px ${h}`}></i>
          <span>{n}</span><b>{cr(h, ground)}</b>
        </div>
      ))}
    </div>

    <h2>Side by side: full versus surface</h2>
    <div class="row">
      {locked.primary.slice(0, 3).map(([n, h], i) => (
        <div class="pair">
          <div style={`background:${h}`}></div>
          <div style={`background:${proposed.surfaces[i][1]}`}></div>
          <span>{n}</span>
        </div>
      ))}
      <div class="pair">
        <div style={`background:${locked.secondary[0][1]}`}></div>
        <div style={`background:${proposed.surfaces[3][1]}`}></div>
        <span>violet</span>
      </div>
    </div>
  </main>
</body>
</html>

<style>
  .wrap { width: min(100% - 4rem, 80rem); padding-block: 3rem 6rem; }
  h1 { font-size: 2rem; margin: 0 0 0.5rem; }
  h2 { font-family: var(--font-mono); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-muted); margin: 2.5rem 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--color-line); }
  .note { max-width: 70ch; color: var(--color-ink-muted); margin: 0; }
  .row { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.75rem; }
  .sw { display: grid; align-content: end; gap: 0.2rem; min-height: 6.5rem; padding: 0.9rem 1rem; border: 1px solid var(--color-line); border-radius: 0.75rem; font-family: var(--font-mono); font-size: 0.75rem; }
  .sw.tall { align-content: end; color: var(--color-ground); }
  .sw span { font-weight: 600; }
  .sw code { opacity: 0.8; }
  .sw b { font-weight: 500; opacity: 0.9; }
  .sw i { display: block; width: 1.4rem; height: 1.4rem; border-radius: 50%; margin-bottom: 0.5rem; }
  .sw.proposed { border-color: var(--color-ink-faint); border-style: dashed; }
  .card { display: grid; grid-template-rows: auto 1fr auto auto; gap: 0.25rem; min-height: 11rem; padding: 1rem 1.1rem; border-radius: 1rem; }
  .card .idx { font-family: var(--font-mono); font-size: 0.7rem; opacity: 0.7; }
  .card .label { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1; margin-top: 0.75rem; }
  .card .hint { font-size: 0.9rem; opacity: 0.85; }
  .card b { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; margin-top: 0.5rem; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; }
  .pair div { height: 5rem; border-radius: 0.5rem; }
  .pair div:first-child { border-radius: 0.5rem 0 0 0.5rem; }
  .pair div:nth-child(2) { border-radius: 0 0.5rem 0.5rem 0; }
  .pair span { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-ink-muted); }
</style>
