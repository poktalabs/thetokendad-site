---
/*
  Round 7 sketch, second pass (not a component, not to ship): tone check only.

  Question the sketch answers: can the station keep its intelligent,
  ruled, professional ground and still feel like a colourful lab where
  things are being tinkered with?

  Borrowed, and from where:
  - ruled command bar with boxed items, headline ticker  (Una Europa, Works in Progress)
  - an active ecosystem: nodes, links, packets in flight (Yamauchi No.10, reinterpreted)
  - colour-filled cards on graphite                      (Meatpacking District)
  - pills for tags and actions                           (Aparelho, Meatpacking)
  - orange / coral / magenta on violet                   (Input)
*/
import '../styles/global.css';

const headlines = [
  ['2026-08-08', 'I deployed the same site to two hosts and got two different URL structures'],
  ['2026-08-07', 'Why I’m building this in public'],
  ['lab', 'website-challenge-v1 closed, four exhibits archived'],
];

// the ecosystem: nodes on a 1400x700 field, links between them, packets travelling the links
const nodes: Record<string, [number, number]> = {
  a: [120, 120], b: [420, 90], c: [700, 160], d: [1000, 80], e: [1300, 140],
  f: [250, 380], g: [620, 420], h: [900, 330], i: [1250, 420],
  j: [450, 640], k: [800, 620], l: [1150, 660],
};
const links: [string, string][] = [
  ['a', 'b'], ['b', 'c'], ['c', 'd'], ['d', 'e'], ['a', 'f'], ['b', 'f'], ['f', 'g'], ['c', 'g'],
  ['g', 'h'], ['d', 'h'], ['h', 'i'], ['e', 'i'], ['f', 'j'], ['g', 'j'], ['g', 'k'], ['h', 'k'],
  ['k', 'l'], ['i', 'l'], ['j', 'k'],
];
const packets: [number, string, number, number, boolean][] = [
  // link index, colour, duration s, delay s, reverse
  [0, 'orange', 6, 0, false], [2, 'magenta', 7, 1.5, true], [6, 'violet', 5, 0.5, false],
  [8, 'coral', 6.5, 2, false], [10, 'orange', 5.5, 3, true], [13, 'magenta', 8, 1, false],
  [15, 'violet', 6, 2.5, true], [16, 'coral', 7, 0, false], [18, 'orange', 9, 4, true],
  [4, 'violet', 7.5, 3.5, false],
];
const coloured = new Set(['c', 'g', 'h', 'k']);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>sketch 7</title>
</head>
<body>
  <header class="bar wrap">
    <a class="cell brand" href="/"><span class="disc"></span>thetoken.dad</a>
    <div class="cell ticker" aria-label="Latest">
      <span class="ticker-label">Latest</span>
      <ul class="ticker-list">
        {headlines.map(([when, what]) => (
          <li><span class="when">{when}</span><span class="what">{what}</span></li>
        ))}
      </ul>
    </div>
    <nav class="cell nav" aria-label="Site">
      <a href="/blog/">Writing</a><a href="/about/">About</a><a href="/website-challenge-v1/">Lab</a>
    </nav>
  </header>

  <section class="hero wrap">
    <svg class="eco" viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="links">
        {links.map(([p, q], idx) => (
          <path id={`lk${idx}`} d={`M${nodes[p][0]} ${nodes[p][1]} L${nodes[q][0]} ${nodes[q][1]}`} />
        ))}
      </g>
      <g class="nodes">
        {Object.entries(nodes).map(([id, [x, y]]) => (
          <circle cx={x} cy={y} r={coloured.has(id) ? 4 : 3} class={coloured.has(id) ? 'hot' : ''} />
        ))}
      </g>
      <g class="packets">
        {packets.map(([li, c, dur, delay, rev]) => {
          const [p, q] = links[li];
          const d = rev
            ? `M${nodes[q][0]} ${nodes[q][1]} L${nodes[p][0]} ${nodes[p][1]}`
            : `M${nodes[p][0]} ${nodes[p][1]} L${nodes[q][0]} ${nodes[q][1]}`;
          return (
            <path class={`pk ${c}`} d={d} pathLength="100" stroke-dasharray="14 300">
              <animate attributeName="stroke-dashoffset" values="14;-100" dur={`${dur}s`} begin={`${delay}s`} repeatCount="indefinite" />
            </path>
          );
        })}
      </g>
    </svg>

    <div class="copy">
      <p class="kicker">The T<span class="sun-o"></span>ken Dad</p>
      <h1>A dad's lab for building with machines, published with receipts.</h1>
      <p class="lede">Guides you can replicate, experiments that sometimes fail, and every peso it costs. Updated from the bench.</p>
      <div class="actions">
        <a class="pill solid" href="/blog/">Read the log <span>&rarr;</span></a>
        <a class="pill" href="/about/">Who is building this</a>
      </div>
    </div>

  </section>

  <nav class="worlds wrap" aria-label="Worlds">
    <a class="card orange" href="/blog/">
      <span class="idx">01</span>
      <span class="label">Writing</span>
      <span class="hint">Guides and posts, with receipts</span>
      <span class="plus">+</span>
    </a>
    <a class="card magenta" href="/about/">
      <span class="idx">02</span>
      <span class="label">The Dad</span>
      <span class="hint">Who is building this, and why</span>
      <span class="plus">+</span>
    </a>
    <a class="card violet" href="/website-challenge-v1/">
      <span class="idx">03</span>
      <span class="label">Lab</span>
      <span class="hint">Experiments, including the closed ones</span>
      <span class="plus">+</span>
    </a>
  </nav>

  <section class="feed wrap">
    <header class="feed-head">
      <h2>Feed</h2>
      <p>Latest transmissions. Newest first.</p>
    </header>
    <ol>
      <li>
        <span class="date">2026-08-08</span>
        <span class="tag">post</span>
        <span class="body">
          <a href="/blog/">I deployed the same site to two hosts and got two different URL structures</a>
          <span class="desc">Choosing between Cloudflare and Vercel by deploying to both instead of reading pricing pages.</span>
        </span>
      </li>
      <li>
        <span class="date">2026-08-07</span>
        <span class="tag">post</span>
        <span class="body">
          <a href="/blog/">Why I'm building this in public</a>
          <span class="desc">I forget things. I got tired of apologizing for it, so I started handing the remembering to machines.</span>
        </span>
      </li>
      <li>
        <span class="date">2026-08-07</span>
        <span class="tag">experiment</span>
        <span class="body">
          <a href="/website-challenge-v1/">website-challenge-v1: four tools, one typeface, closed</a>
          <span class="desc">The design run that produced the first shell. Archived, with the exhibits.</span>
        </span>
      </li>
    </ol>
  </section>
</body>
</html>

<style>
  body { background: var(--color-ground); }
  .wrap { width: min(100% - 4rem, 80rem); }

  /* ---- command bar: ruled, boxed cells ---- */
  .bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    margin-top: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-ground);
    font-size: 0.9rem;
  }
  .cell { display: flex; align-items: center; padding: 0 1.25rem; height: 3.25rem; }
  .cell + .cell { border-left: 1px solid var(--color-line); }
  .brand { gap: 0.6rem; font-weight: 600; text-decoration: none; }
  .brand:hover { color: var(--color-ink); }
  .disc { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--color-magenta); }

  /* the ticker: headlines cycling in the bar */
  .ticker { gap: 1rem; min-width: 0; font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.03em; }
  .ticker-label {
    flex: none;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-magenta);
    color: var(--color-ground);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ticker-list { position: relative; flex: 1; height: 1.4em; margin: 0; padding: 0; list-style: none; overflow: hidden; }
  .ticker-list li {
    position: absolute; inset: 0;
    display: flex; gap: 1rem; align-items: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    color: var(--color-ink-muted);
    opacity: 0;
    animation-name: tick;
    animation-duration: 15s;
    animation-iteration-count: infinite;
  }
  .ticker-list li:nth-child(2) { animation-delay: 5s; }
  .ticker-list li:nth-child(3) { animation-delay: 10s; }
  .when { color: var(--color-ink-faint); text-transform: uppercase; }
  @keyframes tick {
    0% { opacity: 0; transform: translateY(0.6em); }
    3%, 30% { opacity: 1; transform: none; }
    33.3%, 100% { opacity: 0; transform: translateY(-0.6em); }
  }

  .nav { padding: 0; }
  .nav a { display: flex; align-items: center; height: 100%; padding: 0 1.25rem; text-decoration: none; border-left: 1px solid var(--color-line); }
  .nav a:first-child { border-left: 0; }
  .nav a:last-child { border-radius: 0 999px 999px 0; }
  .nav a:hover { background: var(--color-ground-raised); color: var(--color-ink); }

  /* ---- hero ---- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: 3rem;
    padding-block: 6rem 5rem;
  }

  /* the ecosystem: links, nodes, packets in flight; faded where the copy sits */
  .eco {
    position: absolute;
    inset: -2rem -4rem;
    width: calc(100% + 8rem);
    height: calc(100% + 4rem);
    pointer-events: none;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.25) 0%, rgb(0 0 0 / 0.5) 45%, #000 70%);
  }
  .links path { stroke: var(--color-line-strong); stroke-width: 1; fill: none; }
  .nodes circle { fill: var(--color-ink-faint); }
  .nodes .hot { fill: var(--color-ink-muted); }
  /* packets: a short bright dash travelling the link, node to node */
  .pk { fill: none; stroke-width: 2.5; stroke-linecap: round; }
  .pk.orange { stroke: var(--color-orange); filter: drop-shadow(0 0 5px var(--color-orange)); }
  .pk.coral { stroke: var(--color-coral); filter: drop-shadow(0 0 5px var(--color-coral)); }
  .pk.magenta { stroke: var(--color-magenta); filter: drop-shadow(0 0 5px var(--color-magenta)); }
  .pk.violet { stroke: var(--color-violet); filter: drop-shadow(0 0 5px var(--color-violet)); }

  .copy { position: relative; }
  .kicker {
    display: flex; align-items: center; gap: 0.15em;
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .sun-o {
    display: inline-block; width: 0.85em; height: 0.85em; margin: 0 0.2em 0 0.05em;
    border-radius: 50%; background: var(--gradient-sun);
    mask-image: linear-gradient(to bottom, #000 0 54%, transparent 54% 62%, #000 62% 76%, transparent 76% 86%, #000 86% 100%);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    letter-spacing: -0.03em;
    line-height: 1.0;
    max-width: 14ch;
  }
  .lede { max-width: 44ch; margin: 1.5rem 0 0; font-size: 1.15rem; line-height: 1.55; color: var(--color-ink-muted); }
  .actions { display: flex; gap: 0.75rem; margin-top: 2rem; }
  .pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 0.9rem; font-weight: 500;
    text-decoration: none;
    background: var(--color-ground);
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .pill.solid { background: var(--color-ink); color: var(--color-ground); border-color: var(--color-ink); }
  .pill.solid:hover { background: var(--color-magenta); border-color: var(--color-magenta); }


  /* ---- worlds as colour cards ---- */
  .worlds { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.25rem;
    min-height: 15rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    color: var(--color-ground);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease;
  }
  .card:hover { transform: translateY(-4px); color: var(--color-ground); }
  .card.orange { background: var(--color-orange); }
  .card.magenta { background: var(--color-magenta); }
  .card.violet { background: var(--color-violet); color: var(--color-ink); }
  .idx { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; opacity: 0.7; }
  .label { font-family: var(--font-display); font-weight: 700; font-size: 2rem; letter-spacing: -0.02em; text-transform: uppercase; line-height: 1; margin-top: 1rem; }
  .hint { font-size: 0.95rem; opacity: 0.8; max-width: 22ch; }
  .plus {
    position: absolute; right: 1.25rem; bottom: 1.25rem;
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 1.5px solid currentColor; border-radius: 50%;
    font-size: 1.4rem; line-height: 1;
  }

  /* ---- feed, ruled ---- */
  .feed { padding-block: 4rem 5rem; }
  .feed-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 1rem; border-bottom: 1px solid var(--color-line); }
  .feed-head h2 { margin: 0; font-family: var(--font-mono); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .feed-head p { margin: 0; font-size: 0.9rem; color: var(--color-ink-faint); }
  .feed ol { list-style: none; margin: 0; padding: 0; }
  .feed li { display: grid; grid-template-columns: 7.5rem 7rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--color-line); }
  .date { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink-faint); padding-top: 0.35rem; }
  .tag { justify-self: start; align-self: start; padding: 0.25rem 0.7rem; border: 1px solid var(--color-line-strong); border-radius: 999px; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-muted); }
  .body { display: grid; gap: 0.35rem; max-width: 60ch; }
  .body a { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; text-decoration: none; }
  .desc { color: var(--color-ink-muted); font-size: 0.98rem; }

  @media (prefers-reduced-motion: reduce) {
    .ticker-list li { animation: none; }
    .ticker-list li:first-child { opacity: 1; }
    .packets { display: none; }
  }
  @media (max-width: 56rem) {
    .bar { grid-template-columns: 1fr auto; }
    .ticker { display: none; }
    .hero { grid-template-columns: 1fr; padding-block: 3.5rem; }
    .eco { mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.3), #000); }
    .worlds { grid-template-columns: 1fr; }
    .feed li { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
