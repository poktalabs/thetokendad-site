---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts, kindOf, toneOf } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  return posts.map((post, i) => {
    // read next: the two newest other posts, each in its own tone
    const next = posts
      .map((p, j) => ({ p, j }))
      .filter(({ j }) => j !== i)
      .slice(0, 2)
      .map(({ p, j }) => ({
        href: `/blog/${p.id}/`,
        title: p.data.title,
        hint: `${kindOf(p.data.tags)} · ${iso(p.data.pubDate)}`,
        tone: toneOf(j),
      }));
    return { params: { slug: post.id }, props: { post, tone: toneOf(i), next } };
  });
}) satisfies GetStaticPaths;

const { post, tone, next } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  tone={tone}
  next={next}
>
  <Content />
</PostLayout>
