---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { SITE_TITLE } from '../../consts';

const posts = await getPublishedPosts();
---

<BaseLayout title={`Writing · ${SITE_TITLE}`} description="Posts from The Token Dad.">
  <div class="shell page-head">
    <h1 class="page-title">Writing</h1>
    <p class="post-lede">
      Builds, bills, and the parts that didn't work. Each post carries the marks
      for what it is.
    </p>
  </div>

  <div class="shell">
    {
      posts.length === 0 ? (
        <p class="lede column" style="text-align:center">
          Nothing published yet. The first post is being written.
        </p>
      ) : (
        <ul class="entries column">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
