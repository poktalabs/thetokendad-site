---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Feed from '../../components/Feed.astro';
import { getPublishedPosts } from '../../lib/posts';
import SunMark from '../../components/SunMark.astro';
import { SITE_TITLE, ABOUT_HEADLINE, ABOUT_BIO, SOCIAL } from '../../consts';

const posts = await getPublishedPosts();
---

<BaseLayout title={`Writing · ${SITE_TITLE}`} description={`${ABOUT_HEADLINE} ${ABOUT_BIO}`}>
  <!-- the writing hero is the about: who is writing, and where to follow -->
  <section class="who wrap" aria-labelledby="who-title">
    <p class="kicker"><span>Writing</span><span>Who is writing</span></p>
    <div class="who-row">
      <SunMark size="3.25rem" class="who-mark" />
      <div>
        <h1 id="who-title">{ABOUT_HEADLINE}</h1>
        <p class="bio">{ABOUT_BIO}</p>
        <div class="follow">
          <a class="pill" href="/rss.xml">RSS</a>
          <a class="pill" href={SOCIAL.instagram}>@thetokendad on Instagram</a>
        </div>
      </div>
    </div>
  </section>
  <Feed posts={posts} heading="All posts" showAll={false} />
</BaseLayout>

<style>
  .who { padding-block: 3.5rem 1rem; }
  .kicker {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .kicker span + span::before { content: '·'; margin-right: 0.75rem; }
  .who-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 1.5rem;
  }
  .who-row :global(.who-mark) { margin-top: 0.35rem; }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  .bio {
    max-width: 52ch;
    margin: 1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .follow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .pill:hover { border-color: var(--color-ink); color: var(--color-ink); }
  @media (max-width: 40rem) {
    .who-row { grid-template-columns: 1fr; row-gap: 1rem; }
  }
</style>
