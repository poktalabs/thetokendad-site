  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    about: 'AI design run methodology',
    author: {
      '@type': 'Person',
      name: 'Mel',
    },
    publisher: {
      '@type': 'Organization',
      name: 'The Token Dad',
    },
    datePublished: '2026-08-19',
    url,
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'The Token Dad',
        item: 'https://thetoken.dad/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Website Challenge',
        item: 'https://thetoken.dad/website-challenge-v1/',
      },
      {
        '@type': 'ListItem',
